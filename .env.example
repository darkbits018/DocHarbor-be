# Paste your hosted PostgreSQL connection URL here, converted to SQLAlchemy format.
# Example: postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
MAX_UPLOAD_MB=20
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-workers-ai-token
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this secret stable; changing it makes the saved provider API key unreadable.
SETTINGS_ENCRYPTION_KEY=generate-a-fernet-key-and-paste-it-here
